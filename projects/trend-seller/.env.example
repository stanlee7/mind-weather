# true면 모든 collector가 mock 데이터로 동작 (API 키 불필요)
USE_MOCK=true

# 네이버 개발자센터 (데이터랩 API) — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 도매꾹 OpenAPI — https://openapi.domeggook.com (matcher 단계에서 사용)
DOMEGGOOK_API_KEY=

# 네이버 커머스API (스마트스토어 등록, uploader 단계에서 사용)
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
